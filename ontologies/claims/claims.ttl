@prefix : <http://effect-ontology.dev/claims#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix oa: <http://www.w3.org/ns/oa#> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@base <http://effect-ontology.dev/claims> .

# =============================================================================
# Ontology Declaration
# =============================================================================

<http://effect-ontology.dev/claims> rdf:type owl:Ontology ;
    dcterms:title "Effect Ontology Claims Vocabulary"@en ;
    dcterms:description "Vocabulary for reified claims with Wikidata-style ranks, temporal validity, and provenance tracking."@en ;
    dcterms:creator "Effect Ontology Project" ;
    dcterms:created "2024-12-18"^^xsd:date ;
    owl:versionInfo "1.0.0" ;
    rdfs:seeAlso <https://www.wikidata.org/wiki/Help:Ranking> ;
    # OWL Imports for proper ontology loading
    owl:imports <http://www.w3.org/ns/prov#> ;
    owl:imports <http://www.w3.org/ns/oa#> ;
    owl:imports <http://xmlns.com/foaf/0.1/> .

# =============================================================================
# Claim Ranks (Wikidata Pattern)
# =============================================================================

:ClaimRank rdf:type owl:Class ;
    rdfs:label "Claim Rank"@en ;
    rdfs:comment "Enumeration of claim rank values following Wikidata's ranking system."@en ;
    rdfs:seeAlso <https://www.wikidata.org/wiki/Help:Ranking> .

:Preferred rdf:type owl:NamedIndividual, :ClaimRank ;
    rdfs:label "Preferred"@en ;
    rdfs:comment "Current accepted/best value. When multiple claims exist for the same property, preferred claims are shown prominently."@en ;
    :rankOrder 1 .

:Normal rdf:type owl:NamedIndividual, :ClaimRank ;
    rdfs:label "Normal"@en ;
    rdfs:comment "Valid but not highlighted. Used for historical values, alternative names, or secondary information."@en ;
    :rankOrder 2 .

:Deprecated rdf:type owl:NamedIndividual, :ClaimRank ;
    rdfs:label "Deprecated"@en ;
    rdfs:comment "Incorrect, outdated, or retracted. Kept for transparency and audit trail but not used for current queries."@en ;
    :rankOrder 3 .

:rankOrder rdf:type owl:DatatypeProperty ;
    rdfs:label "rank order"@en ;
    rdfs:comment "Numeric ordering for ranks (lower = higher priority). Valid values: 1 (Preferred), 2 (Normal), 3 (Deprecated)."@en ;
    rdfs:domain :ClaimRank ;
    rdfs:range [
        rdf:type rdfs:Datatype ;
        owl:onDatatype xsd:integer ;
        owl:withRestrictions (
            [ xsd:minInclusive 1 ]
            [ xsd:maxInclusive 3 ]
        )
    ] .

# Explicit disjointness for rank individuals
[] rdf:type owl:AllDifferent ;
    owl:distinctMembers ( :Preferred :Normal :Deprecated ) .

# =============================================================================
# Claim Class (Reified Statement)
# =============================================================================

:Claim rdf:type owl:Class ;
    rdfs:subClassOf prov:Entity ;
    rdfs:label "Claim"@en ;
    rdfs:comment "A reified RDF statement extracted from a source document. Claims may conflict with other claims and require curation before becoming assertions."@en .

:DerivedAssertion rdf:type owl:Class ;
    rdfs:subClassOf :Claim ;
    rdfs:label "Derived Assertion"@en ;
    rdfs:comment "A reified statement produced by inference rules rather than direct extraction. Used to distinguish computed facts from extracted facts for transparency and explainability."@en .

:derivedBy rdf:type owl:ObjectProperty ;
    rdfs:label "derived by"@en ;
    rdfs:comment "The reasoning rule or activity that produced this derived assertion."@en ;
    rdfs:domain :DerivedAssertion ;
    rdfs:range prov:Activity .

:supportedBy rdf:type owl:ObjectProperty ;
    rdfs:label "supported by"@en ;
    rdfs:comment "The claims or assertions that served as premises for this inference."@en ;
    rdfs:domain :DerivedAssertion ;
    rdfs:range :Claim .

:claimSubject rdf:type owl:ObjectProperty ;
    rdfs:label "claim subject"@en ;
    rdfs:comment "The subject IRI of the reified statement."@en ;
    rdfs:domain :Claim ;
    rdfs:range rdfs:Resource .

:claimPredicate rdf:type owl:ObjectProperty ;
    rdfs:label "claim predicate"@en ;
    rdfs:comment "The predicate IRI of the reified statement."@en ;
    rdfs:domain :Claim ;
    rdfs:range rdf:Property .

:claimObject rdf:type owl:ObjectProperty ;
    rdfs:label "claim object"@en ;
    rdfs:comment "The object IRI of the reified statement. Use for object properties where the value is a resource/entity."@en ;
    rdfs:domain :Claim ;
    rdfs:range rdfs:Resource .

:claimLiteral rdf:type owl:DatatypeProperty ;
    rdfs:label "claim literal"@en ;
    rdfs:comment "The literal value of the reified statement. Use for datatype properties where the value is a string, number, date, etc."@en ;
    rdfs:domain :Claim ;
    rdfs:range rdfs:Literal .

:rank rdf:type owl:ObjectProperty, owl:FunctionalProperty ;
    rdfs:label "rank"@en ;
    rdfs:comment "The Wikidata-style rank of this claim. Functional: each claim has exactly one rank."@en ;
    rdfs:domain :Claim ;
    rdfs:range :ClaimRank .

:confidence rdf:type owl:DatatypeProperty ;
    rdfs:label "confidence"@en ;
    rdfs:comment "Extraction confidence score between 0 and 1."@en ;
    rdfs:domain :Claim ;
    rdfs:range xsd:double .

# =============================================================================
# Temporal Validity
# =============================================================================

:validFrom rdf:type owl:DatatypeProperty ;
    rdfs:label "valid from"@en ;
    rdfs:comment "Start of the temporal validity period for this claim."@en ;
    rdfs:domain :Claim ;
    rdfs:range xsd:dateTime .

:validUntil rdf:type owl:DatatypeProperty ;
    rdfs:label "valid until"@en ;
    rdfs:comment "End of the temporal validity period for this claim."@en ;
    rdfs:domain :Claim ;
    rdfs:range xsd:dateTime .

:eventTime rdf:type owl:DatatypeProperty ;
    rdfs:label "event time"@en ;
    rdfs:comment "When the real-world event described by this claim occurred."@en ;
    rdfs:domain :Claim ;
    rdfs:range xsd:dateTime .

# =============================================================================
# Transaction Time (Bitemporal: Knowledge Base Timestamps)
# =============================================================================
#
# These properties track WHEN the knowledge base learned/recorded information,
# distinct from valid time (when facts were true in the world). This enables
# "what did we know when?" queries essential for timeline visualization and
# audit trails.
#
# Aligned with W3C PROV-O for transaction time semantics.
# =============================================================================

:publishedAt rdf:type owl:DatatypeProperty ;
    rdfs:label "published at"@en ;
    rdfs:comment """Publisher timestamp for the source document.

    Transaction time dimension tracking when the original publisher released
    the content. Distinct from ingestedAt (when our system received it).

    Example: News article published 2024-12-03T09:00:00Z, ingested by our
    system 2024-12-03T10:15:00Z."""@en ;
    rdfs:domain foaf:Document ;
    rdfs:range xsd:dateTime .

:ingestedAt rdf:type owl:DatatypeProperty ;
    rdfs:label "ingested at"@en ;
    rdfs:comment """System ingestion timestamp for the source document.

    Transaction time dimension tracking when the document entered our knowledge
    base pipeline. Used for timeline queries: 'show me documents we received today'.

    Typically later than publishedAt due to processing delays."""@en ;
    rdfs:domain foaf:Document ;
    rdfs:range xsd:dateTime .

:assertedAt rdf:type owl:DatatypeProperty ;
    rdfs:subPropertyOf prov:generatedAtTime ;
    rdfs:label "asserted at"@en ;
    rdfs:comment """System timestamp when this claim was asserted to the knowledge base.

    Transaction time dimension for claim creation. For extracted claims, this is
    semantically equivalent to extractedAt (both represent when the claim entered
    the KB via LLM extraction).

    Enables competency query: 'show me claims asserted in batch X' or 'what claims
    were added today?'

    Distinct from eventTime (when the real-world event occurred) and validFrom
    (when the fact became true)."""@en ;
    rdfs:domain :Claim ;
    rdfs:range xsd:dateTime .

:retractedAt rdf:type owl:DatatypeProperty ;
    rdfs:subPropertyOf prov:invalidatedAtTime ;
    rdfs:label "retracted at"@en ;
    rdfs:comment """System timestamp when this claim was retracted from the knowledge base.

    Transaction time dimension for claim retraction. Records when the KB learned
    the claim was no longer valid (distinct from when the fact ceased to be true
    in the world, which is validUntil).

    Enables bitemporal queries: 'what did we believe at time T?' requires checking
    both assertedAt <= T and (retractedAt is null OR retractedAt > T).

    Null/absent means the claim is still active in the KB."""@en ;
    rdfs:domain :Claim ;
    rdfs:range xsd:dateTime .

:derivedAt rdf:type owl:DatatypeProperty ;
    rdfs:subPropertyOf prov:generatedAtTime ;
    rdfs:label "derived at"@en ;
    rdfs:comment """System timestamp when this derived assertion was produced by inference.

    Transaction time dimension for reasoning events. Only present on DerivedAssertion
    instances (claims produced by rules rather than extraction).

    Enables competency query: 'show me facts inferred today' or 'which inferred facts
    were produced in batch X?'

    Example: Rule fires at 2024-12-03T10:20:00Z deriving membership from role
    assignment extracted at 2024-12-03T10:15:00Z."""@en ;
    rdfs:domain :DerivedAssertion ;
    rdfs:range xsd:dateTime .

# =============================================================================
# Provenance Properties
# =============================================================================

:statedIn rdf:type owl:ObjectProperty ;
    rdfs:subPropertyOf prov:wasDerivedFrom ;
    rdfs:label "stated in"@en ;
    rdfs:comment "The source article/document where this claim was stated."@en ;
    rdfs:domain :Claim ;
    rdfs:range foaf:Document .

:extractedAt rdf:type owl:DatatypeProperty ;
    rdfs:subPropertyOf prov:generatedAtTime ;
    rdfs:label "extracted at"@en ;
    rdfs:comment "System timestamp when this claim was extracted. Aligned with PROV-O prov:generatedAtTime."@en ;
    rdfs:domain :Claim ;
    rdfs:range xsd:dateTime .

:extractedBy rdf:type owl:ObjectProperty ;
    rdfs:subPropertyOf prov:wasAttributedTo ;
    rdfs:label "extracted by"@en ;
    rdfs:comment "The extraction agent/pipeline that produced this claim. Range narrowed to SoftwareAgent since extraction is always automated."@en ;
    rdfs:domain :Claim ;
    rdfs:range prov:SoftwareAgent .

# =============================================================================
# Deprecation and Supersession
# =============================================================================

:deprecatedAt rdf:type owl:DatatypeProperty ;
    rdfs:label "deprecated at"@en ;
    rdfs:comment "Timestamp when this claim was marked as deprecated."@en ;
    rdfs:domain :Claim ;
    rdfs:range xsd:dateTime .

:deprecationReason rdf:type owl:DatatypeProperty ;
    rdfs:label "deprecation reason"@en ;
    rdfs:comment "Human-readable explanation for why this claim was deprecated."@en ;
    rdfs:domain :Claim ;
    rdfs:range xsd:string .

:supersedes rdf:type owl:ObjectProperty ;
    rdfs:label "supersedes"@en ;
    rdfs:comment "This claim supersedes (replaces) the referenced claim."@en ;
    rdfs:domain :Claim ;
    rdfs:range :Claim .

:supersededBy rdf:type owl:ObjectProperty ;
    owl:inverseOf :supersedes ;
    rdfs:label "superseded by"@en ;
    rdfs:comment "This claim has been superseded (replaced) by the referenced claim."@en ;
    rdfs:domain :Claim ;
    rdfs:range :Claim .

# =============================================================================
# Evidence (W3C Web Annotation aligned)
# =============================================================================
#
# Design Decision: Evidence subclasses oa:Annotation for W3C compliance.
# Our custom properties (evidenceText, startOffset, endOffset) provide
# simplified access while maintaining alignment with oa:TextPositionSelector.
# Full OA patterns can be used alongside these convenience properties.
#
# =============================================================================

:Evidence rdf:type owl:Class ;
    rdfs:subClassOf oa:Annotation ;
    rdfs:label "Evidence"@en ;
    rdfs:comment """Text evidence supporting a claim, aligned with W3C Web Annotation model.

    As a subclass of oa:Annotation, Evidence instances can use standard Web Annotation
    properties (oa:hasBody, oa:hasTarget, oa:hasSelector) alongside our convenience
    properties (evidenceText, startOffset, endOffset).

    The convenience properties map to OA concepts:
    - evidenceText ≈ oa:exact (from oa:TextQuoteSelector)
    - startOffset ≈ oa:start (from oa:TextPositionSelector)
    - endOffset ≈ oa:end (from oa:TextPositionSelector)
    - evidenceSource ≈ oa:hasSource"""@en ;
    rdfs:seeAlso <https://www.w3.org/TR/annotation-vocab/> .

:hasEvidence rdf:type owl:ObjectProperty ;
    rdfs:label "has evidence"@en ;
    rdfs:comment "Links a claim to its supporting evidence."@en ;
    rdfs:domain :Claim ;
    rdfs:range :Evidence .

:evidenceSource rdf:type owl:ObjectProperty ;
    rdfs:subPropertyOf oa:hasSource ;
    rdfs:label "evidence source"@en ;
    rdfs:comment "The source document containing the evidence."@en ;
    rdfs:domain :Evidence ;
    rdfs:range foaf:Document .

:evidenceText rdf:type owl:DatatypeProperty ;
    rdfs:label "evidence text"@en ;
    rdfs:comment "The exact quoted text that serves as evidence."@en ;
    rdfs:domain :Evidence ;
    rdfs:range xsd:string .

:startOffset rdf:type owl:DatatypeProperty ;
    rdfs:label "start offset"@en ;
    rdfs:comment "Character offset where the evidence text starts in the source document."@en ;
    rdfs:domain :Evidence ;
    rdfs:range xsd:integer .

:endOffset rdf:type owl:DatatypeProperty ;
    rdfs:label "end offset"@en ;
    rdfs:comment "Character offset where the evidence text ends in the source document."@en ;
    rdfs:domain :Evidence ;
    rdfs:range xsd:integer .

# =============================================================================
# Article Claim Set (Named Graph Metadata)
# =============================================================================

:ArticleClaimSet rdf:type owl:Class ;
    rdfs:label "Article Claim Set"@en ;
    rdfs:comment "Metadata about a named graph containing all claims from a single article."@en .

:claimStatus rdf:type owl:ObjectProperty, owl:FunctionalProperty ;
    rdfs:label "claim status"@en ;
    rdfs:comment "The curation status of an article's claim set. Functional: each claim set has exactly one status."@en ;
    rdfs:domain :ArticleClaimSet ;
    rdfs:range :ClaimSetStatus .

:ClaimSetStatus rdf:type owl:Class ;
    rdfs:label "Claim Set Status"@en ;
    rdfs:comment "Enumeration of possible statuses for an article's claim set."@en .

:Pending rdf:type owl:NamedIndividual, :ClaimSetStatus ;
    rdfs:label "Pending"@en ;
    rdfs:comment "Claims are awaiting curation/review."@en .

:Accepted rdf:type owl:NamedIndividual, :ClaimSetStatus ;
    rdfs:label "Accepted"@en ;
    rdfs:comment "Claims from this article have been accepted into the knowledge base."@en .

:Retracted rdf:type owl:NamedIndividual, :ClaimSetStatus ;
    rdfs:label "Retracted"@en ;
    rdfs:comment "All claims from this article have been retracted (e.g., due to source correction)."@en .

:containsClaim rdf:type owl:ObjectProperty ;
    rdfs:label "contains claim"@en ;
    rdfs:comment "Links an article claim set to the claims it contains."@en ;
    rdfs:domain :ArticleClaimSet ;
    rdfs:range :Claim .

:sourceArticle rdf:type owl:ObjectProperty ;
    rdfs:label "source article"@en ;
    rdfs:comment "The article this claim set was extracted from."@en ;
    rdfs:domain :ArticleClaimSet ;
    rdfs:range foaf:Document .
