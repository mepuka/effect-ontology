@prefix : <http://effect-ontology.dev/corrections#> .
@prefix claims: <http://effect-ontology.dev/claims#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix dc: <http://purl.org/dc/elements/1.1/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@base <http://effect-ontology.dev/corrections> .

# =============================================================================
# Ontology Declaration
# =============================================================================

<http://effect-ontology.dev/corrections> rdf:type owl:Ontology ;
    dc:title "Effect Ontology Corrections Vocabulary"@en ;
    dc:description "PROV-O based vocabulary for tracking corrections, retractions, and updates to claims."@en ;
    dc:creator "Effect Ontology Project" ;
    dcterms:created "2024-12-18"^^xsd:date ;
    owl:versionInfo "1.0.0" ;
    owl:imports <http://www.w3.org/ns/prov-o#> ;
    owl:imports <http://effect-ontology.dev/claims> .

# =============================================================================
# Correction Types
# =============================================================================

:CorrectionType rdf:type owl:Class ;
    rdfs:label "Correction Type"@en ;
    rdfs:comment "Enumeration of correction types based on journalistic standards."@en .

:Retraction rdf:type owl:NamedIndividual, :CorrectionType ;
    rdfs:label "Retraction"@en ;
    rdfs:comment "Complete withdrawal of a claim. The original claim should be marked as Deprecated."@en .

:Clarification rdf:type owl:NamedIndividual, :CorrectionType ;
    rdfs:label "Clarification"@en ;
    rdfs:comment "Additional context that refines but does not invalidate the original claim."@en .

:Update rdf:type owl:NamedIndividual, :CorrectionType ;
    rdfs:label "Update"@en ;
    rdfs:comment "New information that supersedes a previous claim (e.g., position change)."@en .

:Amendment rdf:type owl:NamedIndividual, :CorrectionType ;
    rdfs:label "Amendment"@en ;
    rdfs:comment "Factual correction to an erroneous claim."@en .

# =============================================================================
# Correction Activity (PROV-O Pattern)
# =============================================================================

:Correction rdf:type owl:Class ;
    rdfs:subClassOf prov:Activity ;
    rdfs:label "Correction"@en ;
    rdfs:comment "An activity that corrects, updates, or retracts one or more claims."@en .

:correctionType rdf:type owl:ObjectProperty ;
    rdfs:label "correction type"@en ;
    rdfs:comment "The type of correction being applied."@en ;
    rdfs:domain :Correction ;
    rdfs:range :CorrectionType .

:correctionDate rdf:type owl:DatatypeProperty ;
    rdfs:subPropertyOf prov:endedAtTime ;
    rdfs:label "correction date"@en ;
    rdfs:comment "When the correction was issued."@en ;
    rdfs:domain :Correction ;
    rdfs:range xsd:dateTime .

:correctionReason rdf:type owl:DatatypeProperty ;
    rdfs:label "correction reason"@en ;
    rdfs:comment "Human-readable explanation for the correction."@en ;
    rdfs:domain :Correction ;
    rdfs:range xsd:string .

:sourceDocument rdf:type owl:ObjectProperty ;
    rdfs:label "source document"@en ;
    rdfs:comment "The article/document that published this correction."@en ;
    rdfs:domain :Correction .

# =============================================================================
# Correction Relationships
# =============================================================================

:invalidates rdf:type owl:ObjectProperty ;
    rdfs:subPropertyOf prov:wasInvalidatedBy ;
    rdfs:label "invalidates"@en ;
    rdfs:comment "This correction invalidates the referenced claim."@en ;
    rdfs:domain :Correction ;
    rdfs:range claims:Claim .

:invalidatedBy rdf:type owl:ObjectProperty ;
    owl:inverseOf :invalidates ;
    rdfs:label "invalidated by"@en ;
    rdfs:comment "This claim was invalidated by the referenced correction."@en ;
    rdfs:domain claims:Claim ;
    rdfs:range :Correction .

:refines rdf:type owl:ObjectProperty ;
    rdfs:label "refines"@en ;
    rdfs:comment "This correction refines (clarifies) the referenced claim without invalidating it."@en ;
    rdfs:domain :Correction ;
    rdfs:range claims:Claim .

:introduces rdf:type owl:ObjectProperty ;
    rdfs:subPropertyOf prov:generated ;
    rdfs:label "introduces"@en ;
    rdfs:comment "This correction introduces a new claim that supersedes an existing one."@en ;
    rdfs:domain :Correction ;
    rdfs:range claims:Claim .

# =============================================================================
# Correction Chain (Audit Trail)
# =============================================================================

:CorrectionChain rdf:type owl:Class ;
    rdfs:label "Correction Chain"@en ;
    rdfs:comment "A sequence of corrections applied to a claim over time."@en .

:hasCorrection rdf:type owl:ObjectProperty ;
    rdfs:label "has correction"@en ;
    rdfs:comment "Links a correction chain to its constituent corrections."@en ;
    rdfs:domain :CorrectionChain ;
    rdfs:range :Correction .

:followsCorrection rdf:type owl:ObjectProperty ;
    rdfs:label "follows correction"@en ;
    rdfs:comment "Temporal ordering of corrections in a chain."@en ;
    rdfs:domain :Correction ;
    rdfs:range :Correction .

:originalClaim rdf:type owl:ObjectProperty ;
    rdfs:label "original claim"@en ;
    rdfs:comment "The original claim that started this correction chain."@en ;
    rdfs:domain :CorrectionChain ;
    rdfs:range claims:Claim .

:currentClaim rdf:type owl:ObjectProperty ;
    rdfs:label "current claim"@en ;
    rdfs:comment "The current (latest) claim in this correction chain."@en ;
    rdfs:domain :CorrectionChain ;
    rdfs:range claims:Claim .

# =============================================================================
# Conflict Detection
# =============================================================================

:Conflict rdf:type owl:Class ;
    rdfs:label "Conflict"@en ;
    rdfs:comment "A detected conflict between two or more claims about the same subject-predicate."@en .

:ConflictType rdf:type owl:Class ;
    rdfs:label "Conflict Type"@en ;
    rdfs:comment "Enumeration of conflict types."@en .

:PositionConflict rdf:type owl:NamedIndividual, :ConflictType ;
    rdfs:label "Position Conflict"@en ;
    rdfs:comment "Claims assert different values for the same subject-predicate without temporal qualification."@en .

:TemporalConflict rdf:type owl:NamedIndividual, :ConflictType ;
    rdfs:label "Temporal Conflict"@en ;
    rdfs:comment "Claims with overlapping temporal validity periods assert different values."@en .

:ContradictoryConflict rdf:type owl:NamedIndividual, :ConflictType ;
    rdfs:label "Contradictory Conflict"@en ;
    rdfs:comment "Claims are logically contradictory (e.g., one negates the other)."@en .

:conflictType rdf:type owl:ObjectProperty ;
    rdfs:label "conflict type"@en ;
    rdfs:domain :Conflict ;
    rdfs:range :ConflictType .

:involvesClaim rdf:type owl:ObjectProperty ;
    rdfs:label "involves claim"@en ;
    rdfs:comment "A claim involved in this conflict."@en ;
    rdfs:domain :Conflict ;
    rdfs:range claims:Claim .

:detectedAt rdf:type owl:DatatypeProperty ;
    rdfs:label "detected at"@en ;
    rdfs:comment "When this conflict was detected."@en ;
    rdfs:domain :Conflict ;
    rdfs:range xsd:dateTime .

:resolvedBy rdf:type owl:ObjectProperty ;
    rdfs:label "resolved by"@en ;
    rdfs:comment "The correction that resolved this conflict."@en ;
    rdfs:domain :Conflict ;
    rdfs:range :Correction .

# =============================================================================
# Resolution Strategies
# =============================================================================

:ResolutionStrategy rdf:type owl:Class ;
    rdfs:label "Resolution Strategy"@en ;
    rdfs:comment "Strategy used to resolve a conflict between claims."@en .

:TemporalPrecedence rdf:type owl:NamedIndividual, :ResolutionStrategy ;
    rdfs:label "Temporal Precedence"@en ;
    rdfs:comment "More recent claims take precedence over older ones."@en .

:SourceAuthority rdf:type owl:NamedIndividual, :ResolutionStrategy ;
    rdfs:label "Source Authority"@en ;
    rdfs:comment "Claims from more authoritative sources take precedence."@en .

:ManualReview rdf:type owl:NamedIndividual, :ResolutionStrategy ;
    rdfs:label "Manual Review"@en ;
    rdfs:comment "Conflict was resolved by human curator."@en .

:resolutionStrategy rdf:type owl:ObjectProperty ;
    rdfs:label "resolution strategy"@en ;
    rdfs:domain :Correction ;
    rdfs:range :ResolutionStrategy .
