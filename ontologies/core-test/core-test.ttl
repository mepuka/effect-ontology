@prefix : <http://effect-ontology.dev/core-test#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix dul: <http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@base <http://effect-ontology.dev/core-test#> .

# =============================================================================
# Core Test Ontology - Minimal DUL Extension
# =============================================================================
#
# Purpose: Test extraction pipeline with DUL foundation
# Only adds what DUL doesn't provide: Person/Org/Place typing
#
# =============================================================================

<http://effect-ontology.dev/core-test> rdf:type owl:Ontology ;
    rdfs:label "Effect Core Test Ontology"@en ;
    rdfs:comment "Minimal DUL-based ontology for extraction testing."@en ;
    owl:versionInfo "0.1.0" ;
    owl:imports <http://www.ontologydesignpatterns.org/ont/dul/DUL.owl> .

# =============================================================================
# Entity Types (extending DUL classes)
# =============================================================================

# Person - extends DUL:Agent (which is subclass of DUL:Object)
:Person rdf:type owl:Class ;
    rdfs:subClassOf dul:Agent ;
    rdfs:label "Person"@en ;
    rdfs:comment "A human being."@en .

# Organization - extends DUL:Organization (which is subclass of DUL:Agent)
:Organization rdf:type owl:Class ;
    rdfs:subClassOf dul:Organization ;
    rdfs:label "Organization"@en ;
    rdfs:comment "A company, institution, or government body."@en .

# Place - extends DUL:Place (which is subclass of DUL:Entity)
:Place rdf:type owl:Class ;
    rdfs:subClassOf dul:Place ;
    rdfs:label "Place"@en ;
    rdfs:comment "A geographic location."@en .

# =============================================================================
# Basic Properties
# =============================================================================

:name rdf:type owl:DatatypeProperty ;
    rdfs:label "name"@en ;
    rdfs:comment "The name of an entity."@en ;
    rdfs:domain dul:Entity ;
    rdfs:range xsd:string .

:description rdf:type owl:DatatypeProperty ;
    rdfs:label "description"@en ;
    rdfs:comment "A description of an entity."@en ;
    rdfs:domain dul:Entity ;
    rdfs:range xsd:string .

# =============================================================================
# Relations (using DUL properties where possible)
# =============================================================================

# Use dul:hasParticipant for event participation
# Use dul:hasPart / dul:isPartOf for mereology
# Use dul:hasLocation for places

:worksFor rdf:type owl:ObjectProperty ;
    rdfs:subPropertyOf dul:associatedWith ;
    rdfs:label "works for"@en ;
    rdfs:comment "Person works for Organization."@en ;
    rdfs:domain :Person ;
    rdfs:range :Organization .

:locatedIn rdf:type owl:ObjectProperty ;
    rdfs:subPropertyOf dul:hasLocation ;
    rdfs:label "located in"@en ;
    rdfs:comment "Entity is located in Place."@en ;
    rdfs:range :Place .
