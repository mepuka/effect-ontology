@prefix : <http://effect-ontology.dev/seattle/> .
@prefix seattle: <http://effect-ontology.dev/seattle/> .
@prefix claims: <http://effect-ontology.dev/claims#> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix org: <http://www.w3.org/ns/org#> .
@prefix time: <http://www.w3.org/2006/time#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix oa: <http://www.w3.org/ns/oa#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@base <http://effect-ontology.dev/seattle> .

# =============================================================================
# Ontology Declaration
# =============================================================================

<http://effect-ontology.dev/seattle> a owl:Ontology ;
    dcterms:title "Seattle Mayor Administration Ontology Pack"@en ;
    dcterms:description """Production ontology for the Seattle mayor administration case study.

    Reuses W3C standard vocabularies:
    - FOAF for persons
    - W3C ORG for organizations, posts, memberships
    - OWL-Time for temporal intervals
    - PROV-O for provenance
    - Web Annotation for evidence spans
    - SKOS for controlled vocabularies

    Extends claims.ttl for conflict-friendly news domain."""@en ;
    dcterms:creator "Effect Ontology Project" ;
    dcterms:created "2025-12-18"^^xsd:date ;
    owl:versionInfo "1.0.0" ;
    rdfs:seeAlso <https://www.w3.org/TR/vocab-org/> ,
                 <https://www.popoloproject.com/specs/> ;
    # OWL Imports for proper ontology loading
    owl:imports <http://xmlns.com/foaf/0.1/> ;
    owl:imports <http://www.w3.org/ns/org#> ;
    owl:imports <http://www.w3.org/2006/time#> ;
    owl:imports <http://www.w3.org/ns/prov#> ;
    owl:imports <http://www.w3.org/ns/oa#> ;
    owl:imports <http://www.w3.org/2004/02/skos/core#> ;
    owl:imports <http://effect-ontology.dev/claims> .

# =============================================================================
# Domain-Specific Classes (Minimal Extensions)
# =============================================================================

# -----------------------------------------------------------------------------
# Organization Extensions
# -----------------------------------------------------------------------------

seattle:BoardOrCommission a owl:Class ;
    rdfs:subClassOf org:Organization ;
    rdfs:label "Board or Commission"@en ;
    rdfs:comment "A board, commission, task force, or advisory body within city government."@en .

# -----------------------------------------------------------------------------
# Post Extensions
# -----------------------------------------------------------------------------

seattle:LeadershipPost a owl:Class ;
    rdfs:subClassOf org:Post ;
    rdfs:label "Leadership Post"@en ;
    rdfs:comment "A department head or leadership position."@en .

# -----------------------------------------------------------------------------
# Event Types (extending prov:Activity)
# -----------------------------------------------------------------------------

seattle:StaffAnnouncementEvent a owl:Class ;
    rdfs:subClassOf prov:Activity ;
    rdfs:label "Staff Announcement Event"@en ;
    rdfs:comment "An official announcement of staff role changes, appointments, or departures."@en .

seattle:PolicyInitiativeEvent a owl:Class ;
    rdfs:subClassOf prov:Activity ;
    rdfs:label "Policy Initiative Event"@en ;
    rdfs:comment "An announcement of a policy initiative, program, or strategic priority."@en .

seattle:BudgetActionEvent a owl:Class ;
    rdfs:subClassOf prov:Activity ;
    rdfs:label "Budget Action Event"@en ;
    rdfs:comment "A budget allocation, cut, or reallocation action."@en .

seattle:CouncilVoteEvent a owl:Class ;
    rdfs:subClassOf prov:Activity ;
    rdfs:label "Council Vote Event"@en ;
    rdfs:comment "A city council vote on legislation, budget, or appointments."@en .

seattle:ReasoningActivity a owl:Class ;
    rdfs:subClassOf prov:Activity ;
    rdfs:label "Reasoning Activity"@en ;
    rdfs:comment """An inference rule execution that produces derived facts.

    Design Decision: Custom class rather than plain prov:Activity because:
    1. Enables typed queries for rule-based inferences (SELECT ?x WHERE { ?x a seattle:ReasoningActivity })
    2. Links to InferenceRule via seattle:appliedRule for rule versioning and impact analysis
    3. Supports fact invalidation tracking when rules change
    4. Integrates with claims:DerivedAssertion for inference transparency

    Usage Pattern:
    - Created when reasoner fires rules during batch processing
    - Links supporting facts via prov:used
    - Links derived facts via prov:generated
    - Timestamps via prov:endedAtTime for audit trail

    Example:
    ```turtle
    :reasoning-001 a seattle:ReasoningActivity ;
        seattle:appliedRule :role-inheritance-rule ;
        prov:used :claim-person-holds-post ;
        prov:generated :derived-person-works-for-org ;
        prov:endedAtTime "2025-12-18T10:00:00Z"^^xsd:dateTime .
    ```"""@en .

seattle:RuleUpdateEvent a owl:Class ;
    rdfs:subClassOf prov:Activity ;
    rdfs:label "Rule Update Event"@en ;
    rdfs:comment """An update to inference rules that may affect derived facts.

    Design Decision: Separate from ReasoningActivity because rule updates:
    1. Represent schema/logic changes, not data derivation
    2. May invalidate previously derived facts (tracked via invalidatedFacts)
    3. Trigger backfill of new facts (tracked via producedFacts)
    4. Require version tracking for reproducibility

    Usage Pattern:
    - Created when inference rules are deployed or modified
    - Links to affected rule via seattle:updatedRule
    - Tracks impact metrics (producedFacts, invalidatedFacts)
    - Timestamps via prov:endedAtTime

    This enables the timeline UX to show "backfill" events when rules change."""@en .

# -----------------------------------------------------------------------------
# Inference Rule (for reasoning transparency)
# -----------------------------------------------------------------------------

seattle:InferenceRule a owl:Class ;
    rdfs:label "Inference Rule"@en ;
    rdfs:comment """A named inference rule used in the reasoning system.

    Design Decision: Explicit class for rules rather than inline SPARQL CONSTRUCT because:
    1. Enables rule versioning via seattle:ruleVersion
    2. Supports impact analysis ("what facts did this rule produce?")
    3. Allows rule provenance ("who authored this rule, when?")
    4. Facilitates rule lifecycle management (deprecation, replacement)

    Typical Properties:
    - skos:prefLabel: Human-readable rule name
    - seattle:ruleVersion: Semantic version string
    - rdfs:comment: Rule description and logic explanation

    Example:
    ```turtle
    :role-inheritance-rule a seattle:InferenceRule ;
        skos:prefLabel "Role Inheritance Rule"@en ;
        seattle:ruleVersion "1.2.0" ;
        rdfs:comment "Derives org:memberOf from org:Membership via org:organization" .
    ```"""@en .

# =============================================================================
# Domain-Specific Properties
# =============================================================================

# -----------------------------------------------------------------------------
# Event Properties
# -----------------------------------------------------------------------------

seattle:announcedMembership a owl:ObjectProperty ;
    rdfs:label "announced membership"@en ;
    rdfs:comment "Links a staff announcement event to the memberships it announces."@en ;
    rdfs:domain seattle:StaffAnnouncementEvent ;
    rdfs:range org:Membership ;
    owl:inverseOf seattle:wasAnnouncedBy .

seattle:wasAnnouncedBy a owl:ObjectProperty ;
    rdfs:label "was announced by"@en ;
    rdfs:comment "Links a membership to the staff announcement event that announced it."@en ;
    rdfs:domain org:Membership ;
    rdfs:range seattle:StaffAnnouncementEvent ;
    owl:inverseOf seattle:announcedMembership .

seattle:announces a owl:ObjectProperty ;
    rdfs:label "announces"@en ;
    rdfs:comment "Links an initiative event to the initiative being announced."@en ;
    rdfs:domain seattle:PolicyInitiativeEvent ;
    owl:inverseOf seattle:wasAnnouncedIn .

seattle:wasAnnouncedIn a owl:ObjectProperty ;
    rdfs:label "was announced in"@en ;
    rdfs:comment "Links an initiative to the event that announced it."@en ;
    rdfs:range seattle:PolicyInitiativeEvent ;
    owl:inverseOf seattle:announces .

seattle:impacts a owl:ObjectProperty ;
    rdfs:label "impacts"@en ;
    rdfs:comment "Links a budget action to affected organizations or programs."@en ;
    rdfs:domain seattle:BudgetActionEvent ;
    rdfs:range org:Organization ;
    owl:inverseOf seattle:impactedBy .

seattle:impactedBy a owl:ObjectProperty ;
    rdfs:label "impacted by"@en ;
    rdfs:comment "Links an organization to budget actions that affect it."@en ;
    rdfs:domain org:Organization ;
    rdfs:range seattle:BudgetActionEvent ;
    owl:inverseOf seattle:impacts .

seattle:voteResult a owl:DatatypeProperty ;
    rdfs:label "vote result"@en ;
    rdfs:comment "The outcome of a council vote (passed, failed, tabled, etc.)."@en ;
    rdfs:domain seattle:CouncilVoteEvent ;
    rdfs:range xsd:string .

seattle:voteTally a owl:DatatypeProperty ;
    rdfs:label "vote tally"@en ;
    rdfs:comment "The vote count (e.g., '7-2' or '9-0')."@en ;
    rdfs:domain seattle:CouncilVoteEvent ;
    rdfs:range xsd:string .

# -----------------------------------------------------------------------------
# Reasoning Properties
# -----------------------------------------------------------------------------

seattle:appliedRule a owl:ObjectProperty ;
    rdfs:label "applied rule"@en ;
    rdfs:comment "Links a reasoning activity to the inference rule that fired."@en ;
    rdfs:domain seattle:ReasoningActivity ;
    rdfs:range seattle:InferenceRule .

seattle:updatedRule a owl:ObjectProperty ;
    rdfs:label "updated rule"@en ;
    rdfs:comment "Links a rule update event to the rule that was modified."@en ;
    rdfs:domain seattle:RuleUpdateEvent ;
    rdfs:range seattle:InferenceRule .

seattle:producedFacts a owl:DatatypeProperty ;
    rdfs:label "produced facts"@en ;
    rdfs:comment "Count of new facts produced by a rule update."@en ;
    rdfs:domain seattle:RuleUpdateEvent ;
    rdfs:range xsd:integer .

seattle:invalidatedFacts a owl:DatatypeProperty ;
    rdfs:label "invalidated facts"@en ;
    rdfs:comment "Count of facts invalidated by a rule update."@en ;
    rdfs:domain seattle:RuleUpdateEvent ;
    rdfs:range xsd:integer .

seattle:ruleVersion a owl:DatatypeProperty ;
    rdfs:label "rule version"@en ;
    rdfs:comment "Version identifier for an inference rule."@en ;
    rdfs:domain seattle:InferenceRule ;
    rdfs:range xsd:string .

# =============================================================================
# SKOS Concept Scheme: Seattle Government Roles
# =============================================================================

seattle:SeattleRoleScheme a skos:ConceptScheme ;
    skos:prefLabel "Seattle Government Roles"@en ;
    dcterms:description """Controlled vocabulary for positions and roles in Seattle city government.

    Design Decision: Roles are dual-typed as both skos:Concept AND org:Role.

    Rationale:
    - skos:Concept enables hierarchical browsing via broader/narrower relationships,
      providing UI-friendly navigation (e.g., "Executive Role" > "Mayor" > "Deputy Mayor")
    - org:Role enables W3C ORG vocabulary integration, allowing roles to be linked
      to org:Post and org:Membership for structural organizational queries

    Benefits of dual-typing:
    1. SKOS layer: Supports faceted search, auto-complete, and concept hierarchy display
    2. ORG layer: Supports "who holds what position" queries with proper cardinality
    3. Interoperability: Both vocabularies are W3C standards with broad tooling support

    Usage:
    - Use skos:broader/narrower for role taxonomy navigation
    - Use org:role on org:Post to link positions to role concepts
    - Query via SPARQL: ?role a skos:Concept, org:Role (returns all dual-typed roles)"""@en .

# -----------------------------------------------------------------------------
# Abstract Role Categories
# -----------------------------------------------------------------------------

seattle:ExecutiveRole a skos:Concept ;
    skos:prefLabel "Executive Role"@en ;
    skos:definition "Senior leadership positions in the mayor's office."@en ;
    skos:topConceptOf seattle:SeattleRoleScheme ;
    skos:inScheme seattle:SeattleRoleScheme .

seattle:DirectorRole a skos:Concept ;
    skos:prefLabel "Director Role"@en ;
    skos:definition "Department or office director positions."@en ;
    skos:topConceptOf seattle:SeattleRoleScheme ;
    skos:inScheme seattle:SeattleRoleScheme .

seattle:CouncilRole a skos:Concept ;
    skos:prefLabel "Council Role"@en ;
    skos:definition "City council positions."@en ;
    skos:topConceptOf seattle:SeattleRoleScheme ;
    skos:inScheme seattle:SeattleRoleScheme .

# -----------------------------------------------------------------------------
# Specific Roles
# -----------------------------------------------------------------------------

seattle:MayorRole a skos:Concept, org:Role ;
    skos:prefLabel "Mayor"@en ;
    skos:altLabel "City Mayor"@en ;
    skos:definition "The chief executive officer of the City of Seattle."@en ;
    skos:broader seattle:ExecutiveRole ;
    skos:inScheme seattle:SeattleRoleScheme .

seattle:DeputyMayorRole a skos:Concept, org:Role ;
    skos:prefLabel "Deputy Mayor"@en ;
    skos:definition "The second-highest executive position, advising the Mayor on strategic priorities."@en ;
    skos:broader seattle:ExecutiveRole ;
    skos:inScheme seattle:SeattleRoleScheme .

seattle:ChiefOfStaffRole a skos:Concept, org:Role ;
    skos:prefLabel "Chief of Staff"@en ;
    skos:definition "Senior advisor managing daily operations of the Mayor's Office."@en ;
    skos:broader seattle:ExecutiveRole ;
    skos:inScheme seattle:SeattleRoleScheme .

seattle:CommunicationsDirectorRole a skos:Concept, org:Role ;
    skos:prefLabel "Communications Director"@en ;
    skos:altLabel "Director of Communications"@en ;
    skos:definition "Head of communications and public affairs."@en ;
    skos:broader seattle:DirectorRole ;
    skos:inScheme seattle:SeattleRoleScheme .

seattle:PolicyDirectorRole a skos:Concept, org:Role ;
    skos:prefLabel "Policy Director"@en ;
    skos:altLabel "Director of Policy"@en , "Director of Policy and Innovation"@en ;
    skos:definition "Head of policy development and strategic initiatives."@en ;
    skos:broader seattle:DirectorRole ;
    skos:inScheme seattle:SeattleRoleScheme .

seattle:BudgetDirectorRole a skos:Concept, org:Role ;
    skos:prefLabel "Budget Director"@en ;
    skos:altLabel "Director of City Budget Office"@en ;
    skos:definition "Head of the City Budget Office."@en ;
    skos:broader seattle:DirectorRole ;
    skos:inScheme seattle:SeattleRoleScheme .

seattle:DepartmentsDirectorRole a skos:Concept, org:Role ;
    skos:prefLabel "Director of Departments"@en ;
    skos:definition "Oversees coordination among city departments."@en ;
    skos:broader seattle:DirectorRole ;
    skos:inScheme seattle:SeattleRoleScheme .

seattle:CommunityRelationsDirectorRole a skos:Concept, org:Role ;
    skos:prefLabel "Director of Community Relations"@en ;
    skos:definition "Head of community engagement and outreach."@en ;
    skos:broader seattle:DirectorRole ;
    skos:inScheme seattle:SeattleRoleScheme .

seattle:CouncilMemberRole a skos:Concept, org:Role ;
    skos:prefLabel "Council Member"@en ;
    skos:altLabel "City Council Member"@en ;
    skos:definition "An elected member of the Seattle City Council."@en ;
    skos:broader seattle:CouncilRole ;
    skos:inScheme seattle:SeattleRoleScheme .

seattle:CouncilPresidentRole a skos:Concept, org:Role ;
    skos:prefLabel "Council President"@en ;
    skos:altLabel "City Council President"@en ;
    skos:definition "The presiding officer of the Seattle City Council."@en ;
    skos:broader seattle:CouncilMemberRole ;
    skos:inScheme seattle:SeattleRoleScheme .

# =============================================================================
# ABox: Seattle Government Structure (Instance Data)
# =============================================================================

# -----------------------------------------------------------------------------
# Organizations
# -----------------------------------------------------------------------------

seattle:CityOfSeattle a org:FormalOrganization ;
    skos:prefLabel "City of Seattle"@en ;
    skos:altLabel "Seattle City Government"@en ;
    org:hasUnit seattle:MayorsOffice ,
                seattle:CityCouncil ,
                seattle:CityBudgetOffice .

seattle:MayorsOffice a org:OrganizationalUnit ;
    skos:prefLabel "Office of the Mayor"@en ;
    skos:altLabel "Mayor's Office"@en ;
    org:unitOf seattle:CityOfSeattle ;
    org:hasUnit seattle:CommunicationsOffice ,
                seattle:PolicyOffice ,
                seattle:CommunityRelationsOffice .

seattle:CommunicationsOffice a org:OrganizationalUnit ;
    skos:prefLabel "Communications Office"@en ;
    org:unitOf seattle:MayorsOffice .

seattle:PolicyOffice a org:OrganizationalUnit ;
    skos:prefLabel "Policy Office"@en ;
    org:unitOf seattle:MayorsOffice .

seattle:CommunityRelationsOffice a org:OrganizationalUnit ;
    skos:prefLabel "Community Relations Office"@en ;
    org:unitOf seattle:MayorsOffice .

seattle:CityCouncil a org:FormalOrganization ;
    skos:prefLabel "Seattle City Council"@en ;
    org:subOrganizationOf seattle:CityOfSeattle .

seattle:CityBudgetOffice a org:OrganizationalUnit ;
    skos:prefLabel "City Budget Office"@en ;
    org:unitOf seattle:CityOfSeattle .

# -----------------------------------------------------------------------------
# Posts (Positions)
# -----------------------------------------------------------------------------

seattle:MayorPost a org:Post ;
    skos:prefLabel "Mayor of Seattle"@en ;
    rdfs:comment "The chief executive officer of the City of Seattle."@en ;
    org:postIn seattle:CityOfSeattle ;
    org:role seattle:MayorRole .

seattle:DeputyMayorPost a org:Post, seattle:LeadershipPost ;
    skos:prefLabel "Deputy Mayor"@en ;
    org:postIn seattle:MayorsOffice ;
    org:role seattle:DeputyMayorRole .

seattle:ChiefOfStaffPost a org:Post, seattle:LeadershipPost ;
    skos:prefLabel "Chief of Staff"@en ;
    org:postIn seattle:MayorsOffice ;
    org:role seattle:ChiefOfStaffRole .

seattle:CommunicationsDirectorPost a org:Post, seattle:LeadershipPost ;
    skos:prefLabel "Communications Director"@en ;
    org:postIn seattle:CommunicationsOffice ;
    org:role seattle:CommunicationsDirectorRole .

seattle:PolicyDirectorPost a org:Post, seattle:LeadershipPost ;
    skos:prefLabel "Policy Director"@en ;
    org:postIn seattle:PolicyOffice ;
    org:role seattle:PolicyDirectorRole .

seattle:BudgetDirectorPost a org:Post, seattle:LeadershipPost ;
    skos:prefLabel "Budget Director"@en ;
    org:postIn seattle:CityBudgetOffice ;
    org:role seattle:BudgetDirectorRole .

seattle:DepartmentsDirectorPost a org:Post, seattle:LeadershipPost ;
    skos:prefLabel "Director of Departments"@en ;
    org:postIn seattle:MayorsOffice ;
    org:role seattle:DepartmentsDirectorRole .

seattle:CommunityRelationsDirectorPost a org:Post, seattle:LeadershipPost ;
    skos:prefLabel "Director of Community Relations"@en ;
    org:postIn seattle:CommunityRelationsOffice ;
    org:role seattle:CommunityRelationsDirectorRole .

seattle:CouncilPresidentPost a org:Post ;
    skos:prefLabel "Council President"@en ;
    org:postIn seattle:CityCouncil ;
    org:role seattle:CouncilPresidentRole .

# =============================================================================
# Named Graph Declarations (for reference)
# =============================================================================
#
# GRAPH seattle:graph/asserted/current - Asserted facts from extraction
# GRAPH seattle:graph/inferred/current - Inferred facts from reasoning
# GRAPH seattle:graph/inferred/ruleRun/{id} - Specific rule run results
# GRAPH seattle:graph/deprecated - Historical/deprecated facts
#
# =============================================================================
