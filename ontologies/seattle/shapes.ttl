@prefix : <http://effect-ontology.dev/seattle/shapes#> .
@prefix seattle: <http://effect-ontology.dev/seattle/> .
@prefix claims: <http://effect-ontology.dev/claims#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix org: <http://www.w3.org/ns/org#> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix time: <http://www.w3.org/2006/time#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@base <http://effect-ontology.dev/seattle/shapes> .

# =============================================================================
# SHACL Shapes for Seattle Ontology Pack Validation
# =============================================================================
#
# These shapes enforce data quality for the Seattle timeline knowledge graph.
# Validation ensures competency questions can be answered correctly.
#
# =============================================================================

# -----------------------------------------------------------------------------
# Person Shape
# -----------------------------------------------------------------------------

:PersonShape a sh:NodeShape ;
    sh:targetClass foaf:Person ;
    rdfs:label "Person Shape"@en ;
    rdfs:comment "Validates person instances have required properties."@en ;

    sh:property [
        sh:path foaf:name ;
        sh:minCount 1 ;
        sh:datatype xsd:string ;
        sh:message "Person must have at least one foaf:name"
    ] .

# -----------------------------------------------------------------------------
# Membership Shape
# -----------------------------------------------------------------------------

:MembershipShape a sh:NodeShape ;
    sh:targetClass org:Membership ;
    rdfs:label "Membership Shape"@en ;
    rdfs:comment "Validates membership instances for temporal role assignments."@en ;

    sh:property [
        sh:path org:member ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:class foaf:Person ;
        sh:message "Membership must have exactly one org:member (a Person)"
    ] ;

    sh:property [
        sh:path org:organization ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:or (
            [ sh:class org:Organization ]
            [ sh:class org:OrganizationalUnit ]
        ) ;
        sh:message "Membership must have exactly one org:organization"
    ] ;

    # W3C ORG: org:post links Membership to Post (the position held)
    sh:property [
        sh:path org:post ;
        sh:minCount 1 ;
        sh:class org:Post ;
        sh:message "Membership must have at least one org:post (the position held)"
    ] ;

    # W3C ORG: org:role optionally classifies the nature of the membership
    sh:property [
        sh:path org:role ;
        sh:minCount 0 ;
        sh:or (
            [ sh:class org:Role ]
            [ sh:class skos:Concept ]
        ) ;
        sh:message "Membership org:role must be a Role or Concept (not Post)"
    ] ;

    sh:property [
        sh:path org:memberDuring ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:class time:Interval ;
        sh:message "Membership must have exactly one org:memberDuring interval"
    ] ;

    # Consistency: post must belong to the membership's organization
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "Membership post must belong to the membership's organization (org:postIn must match org:organization)" ;
        sh:prefixes [
            sh:declare [
                sh:prefix "org" ;
                sh:namespace "http://www.w3.org/ns/org#"^^xsd:anyURI
            ]
        ] ;
        sh:select """
            SELECT $this ?post ?postOrg ?membershipOrg
            WHERE {
                $this org:post ?post .
                $this org:organization ?membershipOrg .
                ?post org:postIn ?postOrg .
                FILTER (?postOrg != ?membershipOrg)
            }
        """
    ] .

# -----------------------------------------------------------------------------
# Time Interval Shape
# -----------------------------------------------------------------------------

:IntervalShape a sh:NodeShape ;
    sh:targetClass time:Interval ;
    rdfs:label "Interval Shape"@en ;
    rdfs:comment "Validates time intervals have required beginning."@en ;

    sh:property [
        sh:path time:hasBeginning ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:class time:Instant ;
        sh:message "Interval must have exactly one time:hasBeginning (a time:Instant)"
    ] ;

    # Note: time:hasEnd is optional (omitted means ongoing)
    sh:property [
        sh:path time:hasEnd ;
        sh:maxCount 1 ;
        sh:class time:Instant ;
        sh:message "Interval may have at most one time:hasEnd (a time:Instant)"
    ] ;

    # Temporal consistency: end must be after beginning (xsd:date)
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "Interval end date must be after beginning date" ;
        sh:prefixes [
            sh:declare [
                sh:prefix "time" ;
                sh:namespace "http://www.w3.org/2006/time#"^^xsd:anyURI
            ] ;
            sh:declare [
                sh:prefix "xsd" ;
                sh:namespace "http://www.w3.org/2001/XMLSchema#"^^xsd:anyURI
            ]
        ] ;
        sh:select """
            SELECT $this ?beginDate ?endDate
            WHERE {
                $this time:hasBeginning/time:inXSDDate ?beginDate .
                $this time:hasEnd/time:inXSDDate ?endDate .
                FILTER (?endDate <= ?beginDate)
            }
        """
    ] ;

    # Temporal consistency: end must be after beginning (xsd:dateTime)
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "Interval end dateTime must be after beginning dateTime" ;
        sh:prefixes [
            sh:declare [
                sh:prefix "time" ;
                sh:namespace "http://www.w3.org/2006/time#"^^xsd:anyURI
            ] ;
            sh:declare [
                sh:prefix "xsd" ;
                sh:namespace "http://www.w3.org/2001/XMLSchema#"^^xsd:anyURI
            ]
        ] ;
        sh:select """
            SELECT $this ?beginDateTime ?endDateTime
            WHERE {
                $this time:hasBeginning/time:inXSDDateTime ?beginDateTime .
                $this time:hasEnd/time:inXSDDateTime ?endDateTime .
                FILTER (?endDateTime <= ?beginDateTime)
            }
        """
    ] .

# -----------------------------------------------------------------------------
# Time Instant Shape
# -----------------------------------------------------------------------------

:InstantShape a sh:NodeShape ;
    sh:targetClass time:Instant ;
    rdfs:label "Instant Shape"@en ;
    rdfs:comment "Validates time instants have a date value."@en ;

    sh:or (
        [ sh:property [
            sh:path time:inXSDDate ;
            sh:minCount 1 ;
            sh:datatype xsd:date
        ] ]
        [ sh:property [
            sh:path time:inXSDDateTime ;
            sh:minCount 1 ;
            sh:datatype xsd:dateTime
        ] ]
    ) ;
    sh:message "Instant must have time:inXSDDate or time:inXSDDateTime" .

# -----------------------------------------------------------------------------
# Post Shape
# -----------------------------------------------------------------------------

:PostShape a sh:NodeShape ;
    sh:targetClass org:Post ;
    rdfs:label "Post Shape"@en ;
    rdfs:comment "Validates post instances have required label and organization."@en ;

    sh:property [
        sh:path skos:prefLabel ;
        sh:minCount 1 ;
        sh:message "Post must have at least one skos:prefLabel"
    ] ;

    sh:property [
        sh:path org:postIn ;
        sh:minCount 1 ;
        sh:message "Post must have at least one org:postIn"
    ] .

# -----------------------------------------------------------------------------
# Staff Announcement Event Shape
# -----------------------------------------------------------------------------

:StaffAnnouncementEventShape a sh:NodeShape ;
    sh:targetClass seattle:StaffAnnouncementEvent ;
    rdfs:label "Staff Announcement Event Shape"@en ;
    rdfs:comment "Validates staff announcement events."@en ;

    sh:property [
        sh:path seattle:announcedMembership ;
        sh:minCount 1 ;
        sh:class org:Membership ;
        sh:message "Staff announcement must announce at least one membership"
    ] ;

    # Use PROV-O activity timestamps (not OWL-Time which requires Instant nodes)
    sh:property [
        sh:path prov:startedAtTime ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:dateTime ;
        sh:message "Event must have exactly one prov:startedAtTime"
    ] ;

    sh:property [
        sh:path prov:wasDerivedFrom ;
        sh:minCount 1 ;
        sh:message "Event must have provenance (prov:wasDerivedFrom source document)"
    ] .

# -----------------------------------------------------------------------------
# Policy Initiative Event Shape
# -----------------------------------------------------------------------------

:PolicyInitiativeEventShape a sh:NodeShape ;
    sh:targetClass seattle:PolicyInitiativeEvent ;
    rdfs:label "Policy Initiative Event Shape"@en ;
    rdfs:comment "Validates policy initiative announcements."@en ;

    sh:property [
        sh:path seattle:announces ;
        sh:minCount 1 ;
        sh:message "Policy initiative event must announce at least one initiative"
    ] ;

    # Use PROV-O activity timestamps (not OWL-Time which requires Instant nodes)
    sh:property [
        sh:path prov:startedAtTime ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:dateTime ;
        sh:message "Event must have exactly one prov:startedAtTime"
    ] ;

    sh:property [
        sh:path prov:wasDerivedFrom ;
        sh:minCount 1 ;
        sh:message "Event must have provenance (prov:wasDerivedFrom source document)"
    ] .

# -----------------------------------------------------------------------------
# Budget Action Event Shape
# -----------------------------------------------------------------------------

:BudgetActionEventShape a sh:NodeShape ;
    sh:targetClass seattle:BudgetActionEvent ;
    rdfs:label "Budget Action Event Shape"@en ;
    rdfs:comment "Validates budget allocation, cut, or reallocation actions."@en ;

    sh:property [
        sh:path seattle:impacts ;
        sh:minCount 1 ;
        sh:or (
            [ sh:class org:Organization ]
            [ sh:class org:OrganizationalUnit ]
        ) ;
        sh:message "Budget action must impact at least one organization"
    ] ;

    # Use PROV-O activity timestamps (not OWL-Time which requires Instant nodes)
    sh:property [
        sh:path prov:startedAtTime ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:dateTime ;
        sh:message "Event must have exactly one prov:startedAtTime"
    ] ;

    sh:property [
        sh:path prov:wasDerivedFrom ;
        sh:minCount 1 ;
        sh:message "Event must have provenance (prov:wasDerivedFrom source document)"
    ] .

# -----------------------------------------------------------------------------
# Council Vote Event Shape
# -----------------------------------------------------------------------------

:CouncilVoteEventShape a sh:NodeShape ;
    sh:targetClass seattle:CouncilVoteEvent ;
    rdfs:label "Council Vote Event Shape"@en ;
    rdfs:comment "Validates city council vote events."@en ;

    sh:property [
        sh:path seattle:voteResult ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ;
        sh:in ( "passed" "failed" "tabled" "withdrawn" "deferred" ) ;
        sh:message "Vote must have exactly one result (passed, failed, tabled, withdrawn, or deferred)"
    ] ;

    # Vote tally accepts: "X-Y" (yes-no) or "X-Y-Z" (yes-no-abstain/absent)
    sh:property [
        sh:path seattle:voteTally ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ;
        sh:pattern "^\\d+-\\d+(-\\d+)?$" ;
        sh:message "Vote tally must be in format 'X-Y' (yes-no) or 'X-Y-Z' (yes-no-abstain)"
    ] ;

    # Use PROV-O activity timestamps (not OWL-Time which requires Instant nodes)
    sh:property [
        sh:path prov:startedAtTime ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:dateTime ;
        sh:message "Event must have exactly one prov:startedAtTime"
    ] ;

    sh:property [
        sh:path prov:wasDerivedFrom ;
        sh:minCount 1 ;
        sh:message "Event must have provenance (prov:wasDerivedFrom source document)"
    ] .

# -----------------------------------------------------------------------------
# Claim Shape (from claims.ttl)
# -----------------------------------------------------------------------------

:ClaimShape a sh:NodeShape ;
    sh:targetClass claims:Claim ;
    rdfs:label "Claim Shape"@en ;
    rdfs:comment "Validates claim instances have required properties."@en ;

    sh:property [
        sh:path claims:claimSubject ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Claim must have exactly one claimSubject"
    ] ;

    sh:property [
        sh:path claims:claimPredicate ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Claim must have exactly one claimPredicate"
    ] ;

    # Object value: must have EITHER claimObject (for IRIs) OR claimLiteral (for literals)
    # Uses sh:xone to enforce exactly one of the two options
    sh:xone (
        [
            sh:property [
                sh:path claims:claimObject ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:nodeKind sh:IRI ;
                sh:message "claimObject must be an IRI"
            ]
        ]
        [
            sh:property [
                sh:path claims:claimLiteral ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:nodeKind sh:Literal ;
                sh:message "claimLiteral must be a literal value"
            ]
        ]
    ) ;

    sh:property [
        sh:path claims:rank ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:in ( claims:Preferred claims:Normal claims:Deprecated ) ;
        sh:message "Claim must have exactly one rank (Preferred, Normal, or Deprecated)"
    ] ;

    sh:property [
        sh:path claims:statedIn ;
        sh:minCount 1 ;
        sh:message "Claim must have at least one statedIn source"
    ] ;

    # Temporal validity: validUntil must be after validFrom (when both present)
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "Claim validUntil must be after validFrom" ;
        sh:prefixes [
            sh:declare [
                sh:prefix "claims" ;
                sh:namespace "http://effect-ontology.dev/claims#"^^xsd:anyURI
            ]
        ] ;
        sh:select """
            SELECT $this ?validFrom ?validUntil
            WHERE {
                $this claims:validFrom ?validFrom .
                $this claims:validUntil ?validUntil .
                FILTER (?validUntil <= ?validFrom)
            }
        """
    ] ;

    # Temporal ordering: eventTime must be before or equal to validFrom
    # A claim's real-world event must occur before the validity period begins
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "Claim eventTime must be before or equal to validFrom (event occurs before validity starts)" ;
        sh:prefixes [
            sh:declare [
                sh:prefix "claims" ;
                sh:namespace "http://effect-ontology.dev/claims#"^^xsd:anyURI
            ]
        ] ;
        sh:select """
            SELECT $this ?eventTime ?validFrom
            WHERE {
                $this claims:eventTime ?eventTime .
                $this claims:validFrom ?validFrom .
                FILTER (?eventTime > ?validFrom)
            }
        """
    ] .

# -----------------------------------------------------------------------------
# Evidence Shape
# -----------------------------------------------------------------------------

:EvidenceShape a sh:NodeShape ;
    sh:targetClass claims:Evidence ;
    rdfs:label "Evidence Shape"@en ;
    rdfs:comment "Validates evidence instances have text and offsets."@en ;

    sh:property [
        sh:path claims:evidenceText ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ;
        sh:message "Evidence must have exactly one evidenceText"
    ] ;

    sh:property [
        sh:path claims:startOffset ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:integer ;
        sh:minInclusive 0 ;
        sh:message "Evidence must have non-negative startOffset"
    ] ;

    sh:property [
        sh:path claims:endOffset ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:integer ;
        sh:minInclusive 0 ;
        sh:message "Evidence must have non-negative endOffset"
    ] ;

    sh:property [
        sh:path claims:evidenceSource ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Evidence must have exactly one evidenceSource"
    ] ;

    # Offset consistency: endOffset must be greater than startOffset
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "Evidence endOffset must be greater than startOffset" ;
        sh:prefixes [
            sh:declare [
                sh:prefix "claims" ;
                sh:namespace "http://effect-ontology.dev/claims#"^^xsd:anyURI
            ]
        ] ;
        sh:select """
            SELECT $this ?startOffset ?endOffset
            WHERE {
                $this claims:startOffset ?startOffset .
                $this claims:endOffset ?endOffset .
                FILTER (?endOffset <= ?startOffset)
            }
        """
    ] .

# -----------------------------------------------------------------------------
# Organization Shape
# -----------------------------------------------------------------------------

:OrganizationShape a sh:NodeShape ;
    sh:targetClass org:Organization ;
    rdfs:label "Organization Shape"@en ;
    rdfs:comment "Validates organization instances."@en ;

    sh:property [
        sh:path skos:prefLabel ;
        sh:minCount 1 ;
        sh:message "Organization must have at least one skos:prefLabel"
    ] .

# -----------------------------------------------------------------------------
# Reasoning Activity Shape
# -----------------------------------------------------------------------------

:ReasoningActivityShape a sh:NodeShape ;
    sh:targetClass seattle:ReasoningActivity ;
    rdfs:label "Reasoning Activity Shape"@en ;
    rdfs:comment "Validates reasoning activities for inference transparency."@en ;

    sh:property [
        sh:path seattle:appliedRule ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:class seattle:InferenceRule ;
        sh:message "Reasoning activity must specify exactly one appliedRule"
    ] ;

    sh:property [
        sh:path prov:used ;
        sh:minCount 1 ;
        sh:message "Reasoning activity must use at least one supporting fact"
    ] ;

    sh:property [
        sh:path prov:generated ;
        sh:minCount 1 ;
        sh:message "Reasoning activity must generate at least one derived fact"
    ] ;

    sh:property [
        sh:path prov:endedAtTime ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:dateTime ;
        sh:message "Reasoning activity must have exactly one endedAtTime"
    ] .

# -----------------------------------------------------------------------------
# Inference Rule Shape
# -----------------------------------------------------------------------------

:InferenceRuleShape a sh:NodeShape ;
    sh:targetClass seattle:InferenceRule ;
    rdfs:label "Inference Rule Shape"@en ;
    rdfs:comment "Validates inference rule instances have required properties."@en ;

    sh:property [
        sh:path skos:prefLabel ;
        sh:minCount 1 ;
        sh:message "Inference rule must have at least one skos:prefLabel"
    ] ;

    sh:property [
        sh:path seattle:ruleVersion ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ;
        sh:message "Inference rule must have exactly one ruleVersion"
    ] .

# -----------------------------------------------------------------------------
# Rule Update Event Shape
# -----------------------------------------------------------------------------

:RuleUpdateEventShape a sh:NodeShape ;
    sh:targetClass seattle:RuleUpdateEvent ;
    rdfs:label "Rule Update Event Shape"@en ;
    rdfs:comment "Validates rule update events for tracking rule lifecycle."@en ;

    sh:property [
        sh:path seattle:updatedRule ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:class seattle:InferenceRule ;
        sh:message "Rule update must specify exactly one updatedRule"
    ] ;

    sh:property [
        sh:path seattle:producedFacts ;
        sh:maxCount 1 ;
        sh:datatype xsd:integer ;
        sh:minInclusive 0 ;
        sh:message "producedFacts must be a non-negative integer"
    ] ;

    sh:property [
        sh:path seattle:invalidatedFacts ;
        sh:maxCount 1 ;
        sh:datatype xsd:integer ;
        sh:minInclusive 0 ;
        sh:message "invalidatedFacts must be a non-negative integer"
    ] ;

    sh:property [
        sh:path prov:endedAtTime ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:dateTime ;
        sh:message "Rule update must have exactly one endedAtTime"
    ] .

# -----------------------------------------------------------------------------
# Claim Rank Shape (for rankOrder validation)
# -----------------------------------------------------------------------------

:ClaimRankShape a sh:NodeShape ;
    sh:targetClass claims:ClaimRank ;
    rdfs:label "Claim Rank Shape"@en ;
    rdfs:comment "Validates claim rank instances."@en ;

    sh:property [
        sh:path claims:rankOrder ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:integer ;
        sh:in ( 1 2 3 ) ;
        sh:message "rankOrder must be 1, 2, or 3 (Preferred, Normal, or Deprecated)"
    ] .

# -----------------------------------------------------------------------------
# Derived Assertion Shape
# -----------------------------------------------------------------------------

:DerivedAssertionShape a sh:NodeShape ;
    sh:targetClass claims:DerivedAssertion ;
    rdfs:label "Derived Assertion Shape"@en ;
    rdfs:comment "Validates derived assertion instances (inferred claims)."@en ;

    # Inherit all Claim constraints
    sh:node :ClaimShape ;

    sh:property [
        sh:path claims:derivedBy ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "DerivedAssertion must specify exactly one derivedBy (reasoning activity or rule)"
    ] ;

    sh:property [
        sh:path claims:supportedBy ;
        sh:minCount 1 ;
        sh:class claims:Claim ;
        sh:message "DerivedAssertion must have at least one supporting claim"
    ] .

# -----------------------------------------------------------------------------
# Article Claim Set Shape
# -----------------------------------------------------------------------------

:ArticleClaimSetShape a sh:NodeShape ;
    sh:targetClass claims:ArticleClaimSet ;
    rdfs:label "Article Claim Set Shape"@en ;
    rdfs:comment "Validates article claim set metadata."@en ;

    sh:property [
        sh:path claims:sourceArticle ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "ArticleClaimSet must have exactly one sourceArticle"
    ] ;

    sh:property [
        sh:path claims:claimStatus ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:in ( claims:Pending claims:Accepted claims:Retracted ) ;
        sh:message "ArticleClaimSet must have exactly one status (Pending, Accepted, or Retracted)"
    ] ;

    sh:property [
        sh:path claims:containsClaim ;
        sh:class claims:Claim ;
        sh:message "containsClaim must reference Claim instances"
    ] .
