@prefix : <http://effect-ontology.dev/core/shapes#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix core: <http://effect-ontology.dev/core#> .
@prefix claims: <http://effect-ontology.dev/claims#> .
@prefix dul: <http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#> .
@base <http://effect-ontology.dev/core/shapes> .

# =============================================================================
# Effect Core Ontology - SHACL Shapes
# =============================================================================
#
# Validation shapes for core ontology instances:
# - MentionShape: Text evidence with required provenance
# - TrackedEntityShape: Domain entities with required name
# - TrackedEventShape: Events with temporal grounding
#
# =============================================================================

<http://effect-ontology.dev/core/shapes> a sh:Ontology ;
    rdfs:label "Effect Core Ontology Shapes"@en ;
    rdfs:comment "SHACL shapes for validating core ontology instances."@en .

# =============================================================================
# MentionShape - Text evidence validation
# =============================================================================

:MentionShape a sh:NodeShape ;
    sh:targetClass core:Mention ;
    rdfs:label "Mention Shape"@en ;
    rdfs:comment "Validates text mentions have required evidence properties."@en ;

    # Required: evidenceText (from claims:Evidence)
    sh:property [
        sh:path claims:evidenceText ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ;
        sh:minLength 1 ;
        sh:name "evidence text"@en ;
        sh:message "Mention must have exactly one non-empty evidenceText."@en ;
    ] ;

    # Required: startOffset (from claims:Evidence)
    sh:property [
        sh:path claims:startOffset ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:integer ;
        sh:minInclusive 0 ;
        sh:name "start offset"@en ;
        sh:message "Mention must have exactly one non-negative startOffset."@en ;
    ] ;

    # Required: endOffset (from claims:Evidence)
    sh:property [
        sh:path claims:endOffset ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:integer ;
        sh:minInclusive 0 ;
        sh:name "end offset"@en ;
        sh:message "Mention must have exactly one non-negative endOffset."@en ;
    ] ;

    # Required: confidence (from claims:Evidence)
    sh:property [
        sh:path claims:confidence ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:decimal ;
        sh:minInclusive 0.0 ;
        sh:maxInclusive 1.0 ;
        sh:name "confidence"@en ;
        sh:message "Mention must have exactly one confidence score between 0.0 and 1.0."@en ;
    ] ;

    # Required: exactly one mentions link
    sh:property [
        sh:path core:mentions ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:or (
            [ sh:class core:TrackedEntity ]
            [ sh:class core:TrackedEvent ]
        ) ;
        sh:name "mentions"@en ;
        sh:message "Mention must link to exactly one TrackedEntity or TrackedEvent."@en ;
    ] .

# =============================================================================
# TrackedEntityShape - Domain entity validation
# =============================================================================

:TrackedEntityShape a sh:NodeShape ;
    sh:targetClass core:TrackedEntity ;
    rdfs:label "Tracked Entity Shape"@en ;
    rdfs:comment "Validates domain entities have required properties."@en ;

    # Required: name
    sh:property [
        sh:path core:name ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ;
        sh:minLength 1 ;
        sh:name "name"@en ;
        sh:message "TrackedEntity must have exactly one non-empty name."@en ;
    ] ;

    # Optional but recommended: description
    sh:property [
        sh:path core:description ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ;
        sh:name "description"@en ;
        sh:severity sh:Info ;
        sh:message "TrackedEntity should have a description."@en ;
    ] ;

    # Recommended: at least one evidential mention
    sh:property [
        sh:path core:hasEvidentialMention ;
        sh:minCount 1 ;
        sh:class core:Mention ;
        sh:name "has evidential mention"@en ;
        sh:severity sh:Warning ;
        sh:message "TrackedEntity should have at least one evidential mention for provenance."@en ;
    ] ;

    # Optional: grounding confidence
    sh:property [
        sh:path core:groundingConfidence ;
        sh:maxCount 1 ;
        sh:datatype xsd:decimal ;
        sh:minInclusive 0.0 ;
        sh:maxInclusive 1.0 ;
        sh:name "grounding confidence"@en ;
        sh:message "groundingConfidence must be between 0.0 and 1.0."@en ;
    ] ;

    # Optional: resolution confidence
    sh:property [
        sh:path core:resolutionConfidence ;
        sh:maxCount 1 ;
        sh:datatype xsd:decimal ;
        sh:minInclusive 0.0 ;
        sh:maxInclusive 1.0 ;
        sh:name "resolution confidence"@en ;
        sh:message "resolutionConfidence must be between 0.0 and 1.0."@en ;
    ] ;

    # sameEntityAs must link to TrackedEntity
    sh:property [
        sh:path core:sameEntityAs ;
        sh:class core:TrackedEntity ;
        sh:name "same entity as"@en ;
        sh:message "sameEntityAs must link to another TrackedEntity."@en ;
    ] ;

    # mergedFrom must link to TrackedEntity
    sh:property [
        sh:path core:mergedFrom ;
        sh:class core:TrackedEntity ;
        sh:name "merged from"@en ;
        sh:message "mergedFrom must link to another TrackedEntity."@en ;
    ] .

# =============================================================================
# TrackedEventShape - Event validation
# =============================================================================

:TrackedEventShape a sh:NodeShape ;
    sh:targetClass core:TrackedEvent ;
    rdfs:label "Tracked Event Shape"@en ;
    rdfs:comment "Validates events have temporal grounding and participants."@en ;

    # Required: either occurrenceTime OR dul:hasTimeInterval
    sh:or (
        [
            sh:property [
                sh:path core:occurrenceTime ;
                sh:minCount 1 ;
            ]
        ]
        [
            sh:property [
                sh:path dul:hasTimeInterval ;
                sh:minCount 1 ;
            ]
        ]
    ) ;
    sh:message "TrackedEvent must have either occurrenceTime or dul:hasTimeInterval."@en ;

    # occurrenceTime datatype validation
    sh:property [
        sh:path core:occurrenceTime ;
        sh:maxCount 1 ;
        sh:datatype xsd:dateTime ;
        sh:name "occurrence time"@en ;
        sh:message "occurrenceTime must be a valid xsd:dateTime."@en ;
    ] ;

    # Recommended: at least one participant
    sh:property [
        sh:path core:hasParticipant ;
        sh:minCount 1 ;
        sh:class core:TrackedEntity ;
        sh:name "has participant"@en ;
        sh:severity sh:Warning ;
        sh:message "TrackedEvent should have at least one participant."@en ;
    ] ;

    # Recommended: at least one evidential mention
    sh:property [
        sh:path core:hasEvidentialMention ;
        sh:minCount 1 ;
        sh:class core:Mention ;
        sh:name "has evidential mention"@en ;
        sh:severity sh:Warning ;
        sh:message "TrackedEvent should have at least one evidential mention for provenance."@en ;
    ] ;

    # Optional: grounding confidence
    sh:property [
        sh:path core:groundingConfidence ;
        sh:maxCount 1 ;
        sh:datatype xsd:decimal ;
        sh:minInclusive 0.0 ;
        sh:maxInclusive 1.0 ;
        sh:name "grounding confidence"@en ;
        sh:message "groundingConfidence must be between 0.0 and 1.0."@en ;
    ] .

# =============================================================================
# Cross-Shape Constraints
# =============================================================================

# Ensure endOffset >= startOffset for mentions
:MentionOffsetConstraint a sh:NodeShape ;
    sh:targetClass core:Mention ;
    rdfs:label "Mention Offset Constraint"@en ;
    sh:sparql [
        sh:message "endOffset must be greater than or equal to startOffset."@en ;
        sh:prefixes [
            sh:declare [
                sh:prefix "claims" ;
                sh:namespace "http://effect-ontology.dev/claims#"^^xsd:anyURI ;
            ]
        ] ;
        sh:select """
            SELECT $this
            WHERE {
                $this claims:startOffset ?start .
                $this claims:endOffset ?end .
                FILTER (?end < ?start)
            }
        """ ;
    ] .

# =============================================================================
# End of SHACL Shapes
# =============================================================================
