@prefix : <http://effect-ontology.dev/core#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix dul: <http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#> .
@prefix claims: <http://effect-ontology.dev/claims#> .
@prefix time: <http://www.w3.org/2006/time#> .
@base <http://effect-ontology.dev/core#> .

# =============================================================================
# Effect Core Ontology V2
# =============================================================================
#
# A minimal DUL-based ontology for knowledge extraction. Extends DOLCE+DnS
# Ultralite with Entity/Mention modeling patterns and integrates with the
# Claims vocabulary for provenance tracking.
#
# Design Principles:
# - Build on DUL, only add what is strictly needed
# - TrackedEntity extends dul:Object (spatiotemporal things)
# - TrackedEvent extends dul:Event (occurrences in time)
# - Mention extends claims:Evidence (textual provenance)
# - Provide shortcuts for LLM-friendly extraction with upgrade paths
#
# =============================================================================

<http://effect-ontology.dev/core> a owl:Ontology ;
    rdfs:label "Effect Core Ontology"@en ;
    dcterms:title "Effect Core Ontology V2"@en ;
    rdfs:comment """Extends DUL with Entity/Mention/Event modeling for ontology-guided knowledge extraction.

Key classes:
- TrackedEntity: Persistent domain entities (persons, organizations, places)
- TrackedEvent: Specific occurrences involving entities
- Mention: Text spans evidencing entity/event references

This ontology provides the foundation for domain-specific extensions."""@en ;
    owl:versionInfo "2.0.0" ;
    dcterms:created "2025-12-24"^^xsd:date ;
    dcterms:creator <https://github.com/pooks> ;
    owl:imports <http://www.ontologydesignpatterns.org/ont/dul/DUL.owl> ;
    owl:imports <http://effect-ontology.dev/claims> .

# =============================================================================
# Core Classes
# =============================================================================

# -----------------------------------------------------------------------------
# TrackedEntity - Persistent domain entities
# -----------------------------------------------------------------------------

:TrackedEntity a owl:Class ;
    rdfs:subClassOf dul:Object ;
    rdfs:label "Tracked Entity"@en ;
    skos:prefLabel "Entity"@en ;
    skos:altLabel "Domain Entity"@en ,
                  "Extracted Entity"@en ;
    skos:definition """A persistent entity in the domain (Person, Organization, Place, Artifact)
that is being tracked across multiple documents and extraction runs.

TrackedEntity extends dul:Object because extracted entities are things with
spatiotemporal extent - they exist in space and time, can participate in events,
and have qualities that can be observed."""@en ;
    rdfs:comment "A persistent entity in the domain that is tracked across documents."@en ;
    skos:scopeNote """Use TrackedEntity for domain objects that:
- Have persistent identity across documents
- Participate in events
- Have attributes (name, description, etc.)
- Can be resolved/linked across mentions

Do NOT use for transient mentions or event occurrences."""@en ;
    skos:example """Examples:
- foaf:Person (John Smith, the mayor)
- org:Organization (City of Seattle, Department of Transportation)
- dul:Place (Seattle, City Hall)
- dul:PhysicalArtifact (a specific document, building)"""@en ;
    :extractionGuidance """When extracting entities, identify:
1. Named entities (proper nouns referring to specific things)
2. Their types from the domain ontology
3. Key attributes (name, description)
4. Text spans where they are mentioned"""@en .

# -----------------------------------------------------------------------------
# TrackedEvent - Occurrences in time
# -----------------------------------------------------------------------------

:TrackedEvent a owl:Class ;
    rdfs:subClassOf dul:Event ;
    rdfs:label "Tracked Event"@en ;
    skos:prefLabel "Event"@en ;
    skos:altLabel "Domain Event"@en ,
                  "Extracted Event"@en ,
                  "Occurrence"@en ;
    skos:definition """A specific occurrence in time involving TrackedEntities.
Events have temporal extent and participants.

TrackedEvent extends dul:Event because occurrences are fundamentally different
from objects - they happen, have duration, and involve participants playing roles."""@en ;
    rdfs:comment "A specific occurrence in time involving entities."@en ;
    skos:scopeNote """Use TrackedEvent for:
- Announcements, meetings, votes, decisions
- Actions and activities with clear start/end
- State changes (appointments, resignations)

Events should have:
- At least one participant (via hasParticipant)
- Temporal grounding (via occurrenceTime or dul:hasTimeInterval)"""@en ;
    skos:example """Examples:
- StaffAnnouncementEvent (mayor announces new director)
- CouncilVoteEvent (council votes 7-2 on budget)
- PolicyInitiativeEvent (new housing policy announced)"""@en ;
    :extractionGuidance """When extracting events, identify:
1. The event type from domain ontology
2. Participants and their roles
3. When the event occurred
4. Text spans describing the event"""@en .

# -----------------------------------------------------------------------------
# Mention - Textual evidence
# -----------------------------------------------------------------------------

:Mention a owl:Class ;
    rdfs:subClassOf claims:Evidence ;
    rdfs:label "Text Mention"@en ;
    skos:prefLabel "Mention"@en ;
    skos:altLabel "Text Span"@en ,
                  "Evidence Span"@en ,
                  "Textual Evidence"@en ;
    skos:definition """A specific span of text in a source document that references
an Entity or Event. This is the evidence layer that tracks WHERE facts come from.

Mention extends claims:Evidence (which extends oa:Annotation) to inherit:
- evidenceText: the exact quoted text
- startOffset/endOffset: character positions
- confidence: extraction confidence score
- statedIn: source document reference
- extractedAt/extractedBy: provenance metadata"""@en ;
    rdfs:comment "A text span in a source document referencing an entity or event."@en ;
    skos:scopeNote """Mentions provide the "evidence trail" for extracted knowledge:
- If an extraction is wrong, delete the Mention, not necessarily the Entity
- Multiple Mentions can reference the same Entity (coreference)
- Mentions enable source verification and confidence aggregation

Mentions are created post-extraction from EvidenceSpan data, not by the LLM directly."""@en ;
    skos:example """Example Mention:
- evidenceText: "Mayor Bruce Harrell"
- startOffset: 42
- endOffset: 60
- confidence: 0.95
- mentions: entity:bruce_harrell"""@en .

# -----------------------------------------------------------------------------
# Disjointness Axiom
# -----------------------------------------------------------------------------

[] a owl:AllDisjoint ;
    owl:members ( :TrackedEntity :TrackedEvent :Mention ) .

# =============================================================================
# Object Properties - Evidence Linking
# =============================================================================

:hasEvidentialMention a owl:ObjectProperty ;
    rdfs:subPropertyOf dul:isReferenceOf ;
    rdfs:label "has evidential mention"@en ;
    rdfs:comment "Links a TrackedEntity or TrackedEvent to text spans that evidence its existence."@en ;
    rdfs:domain [ a owl:Class ;
                  owl:unionOf ( :TrackedEntity :TrackedEvent ) ] ;
    rdfs:range :Mention ;
    skos:definition """Links the semantic Entity/Event to its specific textual evidence.
Each mention records where in the source text this entity/event was referenced."""@en .

:mentions a owl:ObjectProperty ;
    owl:inverseOf :hasEvidentialMention ;
    rdfs:label "mentions"@en ;
    rdfs:comment "Links a text Mention to the Entity or Event it references."@en ;
    rdfs:domain :Mention ;
    rdfs:range [ a owl:Class ;
                 owl:unionOf ( :TrackedEntity :TrackedEvent ) ] ;
    skos:definition "Inverse of hasEvidentialMention. Navigate from text to semantic graph."@en .

# =============================================================================
# Object Properties - Event Participation
# =============================================================================

:hasParticipant a owl:ObjectProperty ;
    rdfs:subPropertyOf dul:hasParticipant ;
    rdfs:label "has participant"@en ;
    rdfs:comment "Links a TrackedEvent to participating TrackedEntities."@en ;
    rdfs:domain :TrackedEvent ;
    rdfs:range :TrackedEntity ;
    skos:definition """A simplified participant relation for LLM extraction.
Maps to dul:hasParticipant but constrains domain/range to core classes."""@en .

:isParticipantIn a owl:ObjectProperty ;
    owl:inverseOf :hasParticipant ;
    rdfs:label "is participant in"@en ;
    rdfs:comment "Links a TrackedEntity to events it participates in."@en ;
    rdfs:domain :TrackedEntity ;
    rdfs:range :TrackedEvent .

# =============================================================================
# Object Properties - Entity Resolution Metadata
# =============================================================================

:sameEntityAs a owl:ObjectProperty ;
    rdfs:subPropertyOf owl:sameAs ;
    a owl:SymmetricProperty , owl:TransitiveProperty ;
    rdfs:label "same entity as"@en ;
    rdfs:comment "Asserts coreference between extracted entities."@en ;
    rdfs:domain :TrackedEntity ;
    rdfs:range :TrackedEntity ;
    skos:definition """Used by entity resolution to assert that two TrackedEntity
instances refer to the same real-world entity. Forms equivalence classes."""@en .

:mergedFrom a owl:ObjectProperty ;
    rdfs:label "merged from"@en ;
    rdfs:comment "Records entity resolution merge history for audit."@en ;
    rdfs:domain :TrackedEntity ;
    rdfs:range :TrackedEntity ;
    skos:definition """Links a canonical entity to the source entities that were merged
into it during entity resolution. Provides audit trail for clustering decisions."""@en .

:resolutionConfidence a owl:DatatypeProperty ;
    rdfs:label "resolution confidence"@en ;
    rdfs:comment "Confidence score for entity resolution match (0.0-1.0)."@en ;
    rdfs:domain :TrackedEntity ;
    rdfs:range xsd:decimal ;
    skos:definition """System-computed confidence that this entity correctly resolves
to its canonical form. Based on embedding similarity, type overlap, and context."""@en .

# =============================================================================
# Object Properties - Spatial Grounding
# =============================================================================

:hasLocation a owl:ObjectProperty ;
    rdfs:subPropertyOf dul:hasLocation ;
    rdfs:label "has location"@en ;
    rdfs:comment "Links an entity or event to its spatial location."@en ;
    rdfs:domain [ a owl:Class ;
                  owl:unionOf ( :TrackedEntity :TrackedEvent ) ] ;
    rdfs:range dul:Place ;
    skos:definition """Spatial grounding for entities and events.
Use when the location is relevant for the extracted knowledge."""@en .

# =============================================================================
# Datatype Properties - Shortcuts
# =============================================================================
#
# These properties provide LLM-friendly shortcuts that bypass complex DUL patterns.
# Each includes documentation for upgrading to full DUL semantics.
#

:name a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:subPropertyOf dul:hasDataValue ;
    rdfs:label "name"@en ;
    rdfs:comment "The canonical name of the entity."@en ;
    rdfs:domain :TrackedEntity ;
    rdfs:range xsd:string ;
    skos:definition """Primary name/label for the entity. Use the most complete,
canonical form (e.g., "Bruce Harrell" not "Harrell" or "the mayor").

Shortcut Pattern: Direct datatype property.
Full DUL Pattern: dul:hasQuality → NameQuality → dul:hasRegion → NameRegion → dul:hasDataValue"""@en .

:description a owl:DatatypeProperty ;
    rdfs:subPropertyOf dul:hasDataValue ;
    rdfs:label "description"@en ;
    rdfs:comment "A brief description of the entity."@en ;
    rdfs:domain :TrackedEntity ;
    rdfs:range xsd:string ;
    skos:definition """Human-readable description of the entity. Can include role,
context, or distinguishing characteristics.

Shortcut Pattern: Direct datatype property.
Full DUL Pattern: Similar to name, use Quality/Region indirection for temporal indexing."""@en .

:occurrenceTime a owl:DatatypeProperty ;
    rdfs:label "occurrence time"@en ;
    rdfs:comment "When the event occurred (ISO 8601 datetime)."@en ;
    rdfs:domain :TrackedEvent ;
    rdfs:range xsd:dateTime ;
    skos:definition """Point-in-time when the event occurred. For events with duration,
represents the start time. Use dul:hasTimeInterval for full interval semantics.

Shortcut Pattern: Direct xsd:dateTime value.
Full DUL Pattern: dul:hasTimeInterval → time:Interval → time:hasBeginning/time:hasEnd"""@en .

# =============================================================================
# Datatype Properties - Confidence (System-Only)
# =============================================================================

:groundingConfidence a owl:DatatypeProperty ;
    rdfs:label "grounding confidence"@en ;
    rdfs:comment "System-computed confidence that this extraction is grounded in source text (0.0-1.0)."@en ;
    rdfs:domain [ a owl:Class ;
                  owl:unionOf ( :TrackedEntity :TrackedEvent ) ] ;
    rdfs:range xsd:decimal ;
    skos:definition """Confidence score computed by the Grounder service, NOT self-reported
by the LLM. Based on embedding similarity between extracted content and source text.

This replaces unreliable LLM-reported confidence with verifiable system metrics."""@en .

# =============================================================================
# Annotation Properties - Extraction Guidance
# =============================================================================

:extractionGuidance a owl:AnnotationProperty ;
    rdfs:label "extraction guidance"@en ;
    rdfs:comment "Instructions for LLM on how to extract instances of this class."@en ;
    rdfs:domain owl:Class ;
    rdfs:range xsd:string ;
    skos:definition """Annotation property providing extraction hints for LLM prompts.
Should describe what to look for, what attributes to extract, and common patterns."""@en .

# =============================================================================
# End of Core Ontology V2
# =============================================================================
