# @core-v2 Environment Configuration
# Copy to .env and fill in your values

# =============================================================================
# REQUIRED: At least one LLM API key
# =============================================================================

# Anthropic Claude (default provider)
ANTHROPIC_API_KEY=sk-ant-api03-your-key-here

# OpenAI (alternative)
# OPENAI_API_KEY=sk-your-key-here

# Google Gemini (alternative)
# GEMINI_API_KEY=AIza-your-key-here

# =============================================================================
# LLM Configuration (optional - sensible defaults)
# =============================================================================

# Provider: anthropic | openai | google
# LLM_PROVIDER=anthropic

# Model name
# LLM_MODEL=claude-haiku-4-5

# Request timeout (ms)
# LLM_TIMEOUT_MS=60000

# Max output tokens
# LLM_MAX_TOKENS=4096

# Temperature (0.0-1.0)
# LLM_TEMPERATURE=0.1

# =============================================================================
# Ontology Configuration
# =============================================================================

# Path to ontology file (TTL/RDF)
# ONTOLOGY_PATH=/path/to/ontology.ttl

# Cache TTL (seconds)
# ONTOLOGY_CACHE_TTL=3600

# =============================================================================
# Runtime Configuration
# =============================================================================

# Parallel chunk processing (reduce if hitting rate limits)
# EXTRACTION_CONCURRENCY=8

# Retry settings for API calls
# RETRY_MAX_ATTEMPTS=8
# RETRY_INITIAL_DELAY_MS=3000
# RETRY_MAX_DELAY_MS=30000

# =============================================================================
# Grounder Configuration
# =============================================================================

# Enable relation grounding
# GROUNDER_ENABLED=true

# Minimum confidence for verification
# GROUNDER_CONFIDENCE_THRESHOLD=0.8

# Batch size for grouped verification
# GROUNDER_BATCH_SIZE=5

# =============================================================================
# RDF Configuration
# =============================================================================

# Base namespace for generated RDF
# RDF_BASE_NAMESPACE=http://example.org/kg/

# Output format: Turtle | N-Triples | JSON-LD
# RDF_OUTPUT_FORMAT=Turtle

# =============================================================================
# Server Configuration (for server.ts)
# =============================================================================

# HTTP port
# PORT=8080
