# @core-v2 Environment Configuration
# Copy to .env and fill in your values
#
# IMPORTANT: This service uses Effect Config with nested prefixes.
# Variables are named: {PREFIX}_{FIELD} (e.g., LLM_API_KEY, STORAGE_BUCKET)

# =============================================================================
# LLM Configuration (nested under LLM_ prefix)
# =============================================================================

# REQUIRED: API key for your chosen provider
LLM_API_KEY=sk-ant-api03-your-key-here

# Provider: anthropic | openai | google (default: anthropic)
LLM_PROVIDER=anthropic

# Model name (default: claude-3-haiku-20240307)
# LLM_MODEL=claude-sonnet-4-20250514

# Request timeout in milliseconds (default: 60000)
# LLM_TIMEOUT_MS=60000

# Max output tokens (default: 4096)
# LLM_MAX_TOKENS=4096

# Temperature 0.0-1.0 (default: 0.1)
# LLM_TEMPERATURE=0.1

# =============================================================================
# Storage Configuration (nested under STORAGE_ prefix)
# =============================================================================

# Storage type: local | gcs | memory (default: local)
# STORAGE_TYPE=local

# GCS bucket name (required for gcs type)
# STORAGE_BUCKET=my-bucket

# Local path for file storage (optional)
# STORAGE_LOCAL_PATH=/tmp/storage

# Path prefix for all keys (default: "")
# STORAGE_PREFIX=

# =============================================================================
# Ontology Configuration (nested under ONTOLOGY_ prefix)
# =============================================================================

# REQUIRED: Path to ontology file (TTL/RDF)
ONTOLOGY_PATH=ontologies/football/ontology.ttl

# Cache TTL in seconds (default: 3600)
# ONTOLOGY_CACHE_TTL=3600

# =============================================================================
# Runtime Configuration (nested under RUNTIME_ prefix)
# =============================================================================

# General concurrency limit (default: 4)
# RUNTIME_CONCURRENCY=4

# LLM-specific concurrency limit (default: 2)
# RUNTIME_LLM_CONCURRENCY=2

# Retry settings for API calls
# RUNTIME_RETRY_MAX=3
# RUNTIME_RETRY_INITIAL_DELAY=1000
# RUNTIME_RETRY_MAX_DELAY=30000

# Enable OpenTelemetry tracing (default: false)
# RUNTIME_ENABLE_TRACING=false

# =============================================================================
# Grounder Configuration (nested under GROUNDER_ prefix)
# =============================================================================

# Enable relation grounding (default: true)
# GROUNDER_ENABLED=true

# Minimum confidence threshold (default: 0.8)
# GROUNDER_THRESHOLD=0.8

# Batch size for grouped verification (default: 5)
# GROUNDER_BATCH_SIZE=5

# =============================================================================
# RDF Configuration (nested under RDF_ prefix)
# =============================================================================

# Base namespace for generated RDF (default: http://example.org/kg/)
# RDF_BASE_NAMESPACE=http://example.org/kg/

# Output format: Turtle | N-Triples | JSON-LD (default: Turtle)
# RDF_OUTPUT_FORMAT=Turtle

# =============================================================================
# Server Configuration
# =============================================================================

# HTTP port (default: 8080)
# PORT=8080

# =============================================================================
# PostgreSQL Configuration (optional - enables durable workflows)
# =============================================================================

# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432
# POSTGRES_DATABASE=workflow
# POSTGRES_USER=workflow
# POSTGRES_PASSWORD=secret
